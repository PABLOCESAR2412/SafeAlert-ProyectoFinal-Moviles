<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeAlert.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Paleta Guardian Precision -->
            <Color x:Key="Navy">#1F3864</Color>
            <Color x:Key="NavyDark">#03224D</Color>
            <Color x:Key="Blue">#0074D5</Color>
            <Color x:Key="BlueDark">#005BB5</Color>
            <Color x:Key="Red">#DC2626</Color>
            <Color x:Key="RedDark">#B91C1C</Color>
            <Color x:Key="Green">#16A34A</Color>
            <Color x:Key="GreenDark">#15803D</Color>
            <Color x:Key="Amber">#D97706</Color>
            <Color x:Key="Surface">#F8F9FB</Color>
            <Color x:Key="SurfaceAlt">#F3F4F6</Color>
            <Color x:Key="Line">#E5E7EB</Color>
            <Color x:Key="TextPrimary">#111827</Color>
            <Color x:Key="TextMuted">#4B5563</Color>
            <Color x:Key="TextSoft">#6B7280</Color>
            <Color x:Key="TextLight">#9CA3AF</Color>
            <Color x:Key="RedTint">#FEE2E2</Color>
            <Color x:Key="RedSoft">#FEF2F2</Color>
            <Color x:Key="GreenTint">#DCFCE7</Color>
            <Color x:Key="MintTint">#ECFDF5</Color>
            <Color x:Key="BlueTint">#DBEAFE</Color>
            <Color x:Key="AmberTint">#FEF3C7</Color>
            <Color x:Key="NavyTint">#EEF2F7</Color>
            <Color x:Key="White">#FFFFFF</Color>

            <!-- Tipografía -->
            <Style x:Key="BaseLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />

            <Style x:Key="H1" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontFamily" Value="InterExtraBold" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="TextColor" Value="{StaticResource Navy}" />
                <Setter Property="LineHeight" Value="1.08" />
            </Style>

            <Style x:Key="H2" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontFamily" Value="InterBold" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="H3" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style x:Key="Body" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="LineHeight" Value="1.3" />
            </Style>

            <Style x:Key="BodySmall" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="LineHeight" Value="1.25" />
            </Style>

            <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource TextSoft}" />
            </Style>

            <Style x:Key="CaptionStrong" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontFamily" Value="InterBold" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextColor" Value="{StaticResource TextSoft}" />
                <Setter Property="CharacterSpacing" Value="1.2" />
            </Style>

            <Style x:Key="LabelSemi" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="LabelBold" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontFamily" Value="InterBold" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="ErrorLabel" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
                <Setter Property="FontFamily" Value="InterMedium" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource Red}" />
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <!-- Contenedores -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource White}" />
                <Setter Property="Stroke" Value="{StaticResource Line}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="16" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#111827" Offset="0,2" Radius="8" Opacity="0.05" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardFlat" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#000000" Offset="0,0" Radius="0" Opacity="0" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InputBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                <Setter Property="Stroke" Value="{StaticResource Line}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InputEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="ClearButtonVisibility" Value="Never" />
            </Style>

            <Style x:Key="InputEditor" TargetType="Editor">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
                <Setter Property="FontFamily" Value="Inter" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="Divider" TargetType="BoxView">
                <Setter Property="Color" Value="{StaticResource Line}" />
                <Setter Property="HeightRequest" Value="1" />
            </Style>

            <!-- Botones -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Blue}" />
                <Setter Property="TextColor" Value="{StaticResource White}" />
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>

            <Style x:Key="NavyButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource Navy}" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource Red}" />
                <Setter Property="FontFamily" Value="InterBold" />
            </Style>

            <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                <Setter Property="TextColor" Value="{StaticResource Navy}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Blue}" />
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="FontFamily" Value="MaterialIcons" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="WidthRequest" Value="40" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>

            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="999" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SwitchStyle" TargetType="Switch">
                <Setter Property="OnColor" Value="{StaticResource Blue}" />
                <Setter Property="ThumbColor" Value="{StaticResource White}" />
            </Style>

            <Style x:Key="PageStyle" TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
