<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:SafeAlert.Helpers"
             x:Class="SafeAlert.Views.AlertDetailPage"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Barra superior -->
        <Grid Grid.Row="0"
              BackgroundColor="White"
              Padding="14,10"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">
            <Button Text="&#xE5C4;"
                    Style="{StaticResource IconButton}"
                    Clicked="Close_Clicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Detalle de alerta"
                       FontFamily="InterBold"
                       FontSize="17"
                       TextColor="{StaticResource Navy}" />
                <Label x:Name="HeaderSubtitle"
                       Text="Reporte cifrado y trazable"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>
            <Border x:Name="HeaderStatusBadge"
                    Grid.Column="2"
                    BackgroundColor="{StaticResource BlueTint}"
                    StrokeThickness="0"
                    Padding="9,4"
                    StrokeShape="RoundRectangle 999"
                    VerticalOptions="Center">
                <Label x:Name="HeaderStatusLabel"
                       Text="Resuelta"
                       FontFamily="InterBold"
                       FontSize="10"
                       TextColor="{StaticResource Navy}" />
            </Border>
        </Grid>
        <BoxView Grid.Row="0" HeightRequest="1" Color="{StaticResource Line}" VerticalOptions="End" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="13">

                <!-- Resumen -->
                <Border Style="{StaticResource Card}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                            <Border x:Name="TypeIconBorder"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    BackgroundColor="{StaticResource RedTint}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    VerticalOptions="Start">
                                <Label x:Name="TypeIconLabel"
                                       Text="&#xF109;"
                                       FontFamily="MaterialIcons"
                                       FontSize="26"
                                       TextColor="{StaticResource RedDark}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="TypeTitleLabel"
                                       Text="Alerta Médica SOS"
                                       FontFamily="InterBold"
                                       FontSize="18"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="WordWrap" />
                                <Label x:Name="DateLabel"
                                       Text="Hoy, 14:32 hrs"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="&#xEA67;"
                                   FontFamily="MaterialIcons"
                                   FontSize="16"
                                   TextColor="{StaticResource TextSoft}" />
                            <Label x:Name="AlertIdLabel"
                                   Grid.Column="1"
                                   Text="ID: A1B2C3D4"
                                   FontSize="11"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="2"
                                    BackgroundColor="{StaticResource SurfaceAlt}"
                                    StrokeThickness="0"
                                    Padding="8,3"
                                    StrokeShape="RoundRectangle 7">
                                <Label x:Name="StatusLabel"
                                       Text="Atendida y Cerrada"
                                       FontFamily="InterBold"
                                       FontSize="9"
                                       TextColor="{StaticResource Blue}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Mapa -->
                <Border x:Name="MapCard"
                        Style="{StaticResource Card}"
                        Padding="0"
                        StrokeShape="RoundRectangle 16">
                    <Grid HeightRequest="175">
                        <Image Source="map_alert.png"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
                        <Border BackgroundColor="#E6FFFFFF"
                                StrokeThickness="0"
                                Padding="9,7"
                                StrokeShape="RoundRectangle 9"
                                Margin="8"
                                HorizontalOptions="Fill"
                                VerticalOptions="End">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="&#xF1DB;"
                                       FontFamily="MaterialIcons"
                                       FontSize="16"
                                       TextColor="{StaticResource Red}" />
                                <Label x:Name="MapAddressLabel"
                                       Grid.Column="1"
                                       Text="Calle Liverpool 88, Col. Juárez"
                                       FontSize="11"
                                       TextColor="{StaticResource Navy}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Ubicación -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="UBICACIÓN DEL EVENTO"
                               Style="{StaticResource CaptionStrong}"
                               TextColor="{StaticResource TextMuted}" />
                        <Label x:Name="AddressLabel"
                               Text="Calle Liverpool 88, Col. Juárez"
                               FontFamily="InterSemiBold"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap" />
                        <Label x:Name="CoordinatesLabel"
                               Text="Lat: 19.4270, Lon: -99.1676"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Mensaje -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="MENSAJE DE AUXILIO"
                               Style="{StaticResource CaptionStrong}"
                               TextColor="{StaticResource TextMuted}" />
                        <Label x:Name="MessageLabel"
                               Text="Emergencia médica. Dolor en el pecho y dificultad para respirar."
                               FontSize="13"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Datos del reporte -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="DATOS DEL REPORTE"
                               Style="{StaticResource CaptionStrong}"
                               TextColor="{StaticResource TextMuted}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="&#xF233;"
                                   FontFamily="MaterialIcons"
                                   FontSize="19"
                                   TextColor="{StaticResource Navy}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Contactos notificados"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label x:Name="ContactsLabel"
                                       Text="3 contactos notificados en tiempo real"
                                       FontFamily="InterSemiBold"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource Divider}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="&#xF803;"
                                   FontFamily="MaterialIcons"
                                   FontSize="19"
                                   TextColor="{StaticResource Blue}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Respuesta y seguimiento"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label x:Name="ResponseLabel"
                                       Text="Tiempo de respuesta: 8 min"
                                       FontFamily="InterSemiBold"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource Divider}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="&#xE31D;"
                                   FontFamily="MaterialIcons"
                                   FontSize="19"
                                   TextColor="{StaticResource RedDark}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Audio de emergencia"
                                       FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label x:Name="AudioLabel"
                                       Text="Grabación de audio disponible"
                                       FontFamily="InterSemiBold"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Notas -->
                <Border x:Name="NotesCard"
                        BackgroundColor="{StaticResource SurfaceAlt}"
                        StrokeThickness="0"
                        Padding="13"
                        StrokeShape="RoundRectangle 13">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="NOTAS DEL DESPACHO"
                               Style="{StaticResource CaptionStrong}"
                               TextColor="{StaticResource TextMuted}" />
                        <Label x:Name="NotesLabel"
                               Text="Ambulancia y contactos notificados. La usuaria fue atendida."
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Acciones -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="16,10,16,14"
              RowDefinitions="1,Auto">
            <BoxView Grid.Row="0" HeightRequest="1" Color="{StaticResource Line}" Margin="-16,-10,-16,0" VerticalOptions="Start" />
            <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="ResolveButton"
                        Text="Marcar como resuelta"
                        BackgroundColor="{StaticResource Green}"
                        TextColor="White"
                        FontFamily="InterSemiBold"
                        FontSize="14"
                        HeightRequest="46"
                        CornerRadius="11"
                        ContentLayout="Left,8"
                        Clicked="Resolve_Clicked">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="&#xF0BE;"
                                         Color="White"
                                         Size="20" />
                    </Button.ImageSource>
                </Button>
                <Button x:Name="FalseAlarmButton"
                        Text="Marcar como falsa alarma"
                        Style="{StaticResource SoftButton}"
                        FontSize="13"
                        HeightRequest="42"
                        Clicked="FalseAlarm_Clicked" />
                <Label x:Name="ClosedLabel"
                       Text="Este evento ya está cerrado. El reporte se conserva en tu historial cifrado."
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
