<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:SafeAlert.Helpers"
             x:Class="SafeAlert.Views.HomeView"
             BackgroundColor="{StaticResource Surface}">

    <Grid>
        <ScrollView x:Name="HomeScroll">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Estado del sistema -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border BackgroundColor="{StaticResource MintTint}"
                            Stroke="#A7F3D0"
                            StrokeThickness="1"
                            Padding="12,10"
                            StrokeShape="RoundRectangle 14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                                     Color="{StaticResource Green}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="SISTEMA ACTIVO &amp; PROTEGIDO"
                                       FontFamily="InterBold" FontSize="10"
                                       TextColor="{StaticResource GreenDark}" />
                                <Label Text="Ubicación del dispositivo"
                                       FontSize="11" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="&#xF013;"
                                   FontFamily="MaterialIcons" FontSize="22"
                                   TextColor="{StaticResource GreenDark}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10,8" WidthRequest="112">
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Label Text="&#xE9E0;"
                                   FontFamily="MaterialIcons" FontSize="18"
                                   TextColor="{StaticResource Navy}" HorizontalOptions="Center" />
                            <Label Text="Modo Seguro"
                                   FontFamily="InterSemiBold" FontSize="10"
                                   TextColor="{StaticResource Navy}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Ubicación -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="42" HeightRequest="42"
                                BackgroundColor="{StaticResource NavyTint}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Start">
                            <Label Text="&#xE55C;"
                                   FontFamily="MaterialIcons" FontSize="22"
                                   TextColor="{StaticResource Blue}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="UBICACIÓN ACTUAL"
                                   Style="{StaticResource CaptionStrong}"
                                   TextColor="{StaticResource TextSoft}" />
                            <Label x:Name="AddressLabel"
                                   Text="Av. Amazonas N34-12 y Naciones Unidas, Quito"
                                   FontFamily="InterBold" FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="WordWrap" MaxLines="2" />
                            <Label x:Name="PrecisionLabel"
                                   Text="Precisión exacta: 15 m"
                                   Style="{StaticResource BodySmall}" />
                        </VerticalStackLayout>

                        <Button x:Name="RefreshLocationButton"
                                Grid.Column="2"
                                Text="&#xE5D5;"
                                Style="{StaticResource IconButton}"
                                Clicked="RefreshLocation_Clicked"
                                VerticalOptions="Start" />

                        <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                 Style="{StaticResource Divider}"
                                 Margin="0,10,0,0" />

                        <Grid Grid.Row="2" Grid.ColumnSpan="3"
                              ColumnDefinitions="*,*,*" ColumnSpacing="8"
                              Margin="0,9,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <Label Text="&#xEBBA;"
                                       FontFamily="MaterialIcons" FontSize="14"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Grid.Column="1" LineBreakMode="WordWrap" x:Name="NetworkLabel" Text="Red 5G"
                                       FontFamily="InterMedium" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <Label Text="&#xEB3A;"
                                       FontFamily="MaterialIcons" FontSize="14"
                                       TextColor="{StaticResource TextMuted}" />
                                <Label Grid.Column="1" LineBreakMode="WordWrap" x:Name="GpsLabel" Text="GPS Activo"
                                       FontFamily="InterMedium" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                            </Grid>
                            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <Label Text="&#xF8B0;"
                                       FontFamily="MaterialIcons" FontSize="14"
                                       TextColor="{StaticResource GreenDark}" />
                                <Label Grid.Column="1" LineBreakMode="WordWrap" x:Name="BatteryLabel" Text="—"
                                       FontFamily="InterMedium" FontSize="11"
                                       TextColor="{StaticResource TextMuted}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Botón SOS -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,4,0,0">
                    <Grid WidthRequest="250" HeightRequest="250" HorizontalOptions="Center">
                        <Border WidthRequest="250" HeightRequest="250"
                                BackgroundColor="{StaticResource RedSoft}"
                                Stroke="{StaticResource RedTint}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 125"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border WidthRequest="212" HeightRequest="212"
                                BackgroundColor="{StaticResource RedTint}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 106"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border WidthRequest="184" HeightRequest="184"
                                BackgroundColor="{StaticResource Red}"
                                Stroke="#B91C1C"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 92"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="&#xF119;"
                                       FontFamily="MaterialIcons" FontSize="34"
                                       TextColor="White" HorizontalOptions="Center" />
                                <Label Text="SOS"
                                       FontFamily="InterExtraBold" FontSize="34"
                                       TextColor="White" HorizontalOptions="Center" />
                                <Label Text="ABRIR 911"
                                       FontFamily="InterBold" FontSize="10"
                                       CharacterSpacing="1.5"
                                       TextColor="#FEE2E2" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Button x:Name="SosTouchButton"
                                Text=""
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                WidthRequest="250"
                                HeightRequest="250"
                                CornerRadius="125"
                                Clicked="SosDial_Clicked"
                                SemanticProperties.Description="Abrir el marcador del 911" />
                    </Grid>


                    <Border BackgroundColor="{StaticResource RedTint}"
                            StrokeThickness="0"
                            Padding="12,6"
                            StrokeShape="RoundRectangle 999"
                            HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="&#xE913;"
                                   FontFamily="MaterialIcons" FontSize="16"
                                   TextColor="{StaticResource RedDark}" />
                            <Label Text="Abre el marcador; tú confirmas la llamada"
                                   FontFamily="InterSemiBold" FontSize="11"
                                   TextColor="{StaticResource RedDark}" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Alertar a contacto de emergencia"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="46"
                        Clicked="AlertContact_Clicked" />

                <!-- Contactos enlazados -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="GoContacts_Tapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <HorizontalStackLayout x:Name="HomeAvatars" Spacing="0" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label x:Name="HomeContactsTitle"
                                   Text="3 Contactos enlazados"
                                   FontFamily="InterBold" FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label x:Name="HomeContactsSubtitle"
                                   Text="Listos para recibir alerta y mapa en vivo"
                                   Style="{StaticResource BodySmall}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xE5CC;"
                               FontFamily="MaterialIcons" FontSize="22"
                               TextColor="{StaticResource TextSoft}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Prueba de señal -->
                <Border BackgroundColor="{StaticResource MintTint}"
                        Stroke="#BBF7D0"
                        StrokeThickness="1"
                        Padding="12"
                        StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="&#xF0BE;"
                               FontFamily="MaterialIcons" FontSize="20"
                               TextColor="{StaticResource GreenDark}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Comprobar estado del dispositivo"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Text="Ver"
                                Style="{StaticResource GhostButton}"
                                Clicked="TestStatus_Clicked" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentView>

