<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeAlert.Views.LegalPage"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              BackgroundColor="White"
              Padding="14,10"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10">
            <Button Text="&#xE5C4;"
                    Style="{StaticResource IconButton}"
                    Clicked="Close_Clicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Privacidad y Términos"
                       FontFamily="InterBold"
                       FontSize="17"
                       TextColor="{StaticResource Navy}" />
                <Label Text="SafeAlert · Política vigente 2026-11"
                       FontSize="10"
                       TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,16,18,28" Spacing="14">

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="1. Responsable del tratamiento"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="SafeAlert es un proyecto académico desarrollado en la Universidad Israel (Quito, Ecuador). El responsable de los datos es el titular de la cuenta registrada en la aplicación. Contacto de soporte: soporte@safealert.app." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="2. Datos que se recopilan"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="• Identificación: nombre, teléfono y correo electrónico.&#10;• Contactos de emergencia: nombre, teléfono, parentesco y prioridad.&#10;• Ficha médica: tipo de sangre, alergias y médico de cabecera.&#10;• Ubicación: latitud, longitud y precisión del GPS, solo al actualizar la posición o al generar una alerta.&#10;• Alertas: tipo, fecha, estado y mensaje enviado." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="3. Para qué se usan"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="Los datos se usan únicamente para registrar la cuenta, mostrar tu red de apoyo y compartir tu ubicación cuando tú activas una alerta. No se usan para publicidad, perfilamiento comercial ni venta a terceros." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="4. Dónde se almacenan"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="Esta versión guarda la información en el almacenamiento privado del teléfono, en el archivo safealert.json. No existe todavía un servidor propio ni una base de datos remota. Las contraseñas se guardan como hash, nunca en texto plano." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="5. Conservación y borrado"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="Las alertas se conservan mientras la cuenta esté activa. Puedes borrar el historial desde la pantalla Historial y eliminar contactos desde Contactos. Al cerrar sesión se elimina la sesión guardada. Si desinstalas la app, Android elimina todos los datos locales." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="6. Con quién se comparte"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="Solo con los contactos que tú registras. Al enviar una alerta se abre WhatsApp con un enlace de Google Maps para el contacto principal y se prepara un SMS para los demás. SafeAlert no envía datos a ECU911, no usa la API de WhatsApp y no tiene acceso a tus conversaciones. Tu operador y Google Maps tratan el mensaje según sus propias políticas." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="7. Permisos del dispositivo"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="• Ubicación: para mostrar tu posición y adjuntarla a la alerta.&#10;• Contactos: solo cuando usas «Elegir de mis contactos» para no escribir el número.&#10;• Acelerómetro: detecta sacudidas fuertes mientras la app está abierta; no requiere permiso especial en Android.&#10;• Huella digital: desbloquea el acceso rápido con la biometría del sistema.&#10;Puedes revocar cualquier permiso desde Ajustes de Android; la app seguirá funcionando con datos manuales." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="8. Seguridad"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="Contraseñas con hash y comparación segura. Los datos viajan dentro del dispositivo y las integraciones externas usan HTTPS. Esta versión no implementa cifrado de extremo a extremo ni un servidor remoto; esa migración está planificada con HTTPS obligatorio, autenticación por token y registro de auditoría." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="9. Tus derechos"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="Puedes acceder, rectificar y eliminar tus datos desde Perfil y Contactos. También puedes solicitar una copia escribiendo a soporte@safealert.app. La aplicación no toma decisiones automatizadas sobre tu persona." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="10. Términos de uso"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="SafeAlert es una herramienta de apoyo y no reemplaza a los servicios de emergencia. No garantiza la entrega de mensajes: depende de la cobertura, la batería, el GPS y la confirmación que hagas en WhatsApp o en tu app de mensajes. No debe usarse como único medio para pedir ayuda en una situación de riesgo." />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="11. Cambios en esta política"
                               FontFamily="InterBold"
                               FontSize="14"
                               TextColor="{StaticResource Navy}" />
                        <Label FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="WordWrap"
                               Text="Cuando cambie el tratamiento de datos se actualizará esta pantalla y la versión de la política. El uso continuado de la app implica la aceptación de la versión vigente." />
                        <Label x:Name="VersionLabel"
                               FontSize="11"
                               TextColor="{StaticResource TextMuted}"
                               Text="Versión de la aplicación: 1.1" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Volver"
                        Style="{StaticResource NavyButton}"
                        Clicked="Close_Clicked"
                        Margin="0,4,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
